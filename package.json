{
  "name": "xp",
  "version": "0.1.0",
  "description": "Experiment Framework for your JavaScript/TypeScript projects.",
  "keywords": [
    "experiment",
    "framework",
    "xp"
  ],
  "license": "MIT",
  "author": "frostme",
  "bin": "./dist/cli/index.js",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli/index.js",
    "./server": "./dist/server/index.js",
    "./client": "./dist/client/index.js"
  },
  "scripts": {
    "build": "wireit",
    "build:swc": "swc src -d dist --config-file .swcrc --strip-leading-paths --ignore \"**/__tests__/**\"",
    "build:tsc": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js",
    "ci": "wireit",
    "circular:check": "wireit",
    "docker:down": "docker compose -f docker-compose.test.yml down",
    "docker:up": "docker compose -f docker-compose.test.yml up -d",
    "format": "wireit",
    "format:check": "wireit",
    "lint": "wireit",
    "lint:unused": "knip",
    "prepare": "husky",
    "test:integration": "wireit",
    "test:unit": "wireit",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.tmp/typecheck.tsbuildinfo",
    "test:package": "wireit"
  },
  "wireit": {
    "build": {
      "command": "concurrently \"bun build:swc\" \"bun build:tsc\"",
      "files": [
        "src/**/*.ts",
        ".swcrc",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map",
        "node_modules/.tmp/tsconfig.tsbuildinfo"
      ],
      "allowUsuallyExcludedPaths": true
    },
    "ci": {
      "dependencies": [
        "build",
        "lint",
        "lint:unused",
        "typecheck",
        "circular:check",
        "format:check",
        "test:unit",
        "test:package"
      ]
    },
    "test:unit": {
      "command": "vitest run --config vitest.unit.config.ts",
      "files": [
        "src/**/*.ts",
        "vitest.unit.config.ts",
        "package.json"
      ]
    },
    "test:integration": {
      "command": "vitest run --config vitest.integration.config.ts"
    },
    "circular:check": {
      "command": "dpdm",
      "files": [
        "src/**/*",
        "package.json",
        "tsconfig.json"
      ],
      "output": []
    },
    "format": {
      "command": "oxfmt --write ."
    },
    "format:check": {
      "command": "oxfmt --check ."
    },
    "lint": {
      "command": "oxlint -c oxlint.config.ts . --ignore-pattern \"vitest*.ts\" --deny-warnings",
      "files": [
        "src/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "*.ts",
        "oxlint.config.ts",
        "tsconfig.json"
      ],
      "output": []
    },
    "test:package": {
      "command": "node scripts/package-smoke.mjs",
      "dependencies": [
        "build"
      ]
    }
  },
  "dependencies": {
    "dpdm": "^4.3.0",
    "es-toolkit": "^1.52.0",
    "pino": "^10.4.0",
    "type-fest": "^5.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "pg": "^8.23.1",
    "tsc-alias": "^1.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wireit": "^0.14.13"
  },
  "peerDependencies": {
    "pg": "^8.23.1"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.4"
}
