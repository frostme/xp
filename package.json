{
  "name": "@frostme/xp",
  "version": "0.1.0",
  "description": "Experiment Framework for your JavaScript/TypeScript projects.",
  "keywords": [
    "experiment",
    "framework",
    "xp"
  ],
  "license": "MIT",
  "author": "frostme",
  "bin": {
    "xp": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "imports": {
    "#xp-gates": "./dist/client/gates.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli/index.js",
    "./server": "./dist/server/index.js",
    "./client": "./dist/client/index.js",
    "./server/express": "./dist/server/express/index.js",
    "./server/graphql": "./dist/server/graphql/index.js",
    "./react": "./dist/client/react/index.js",
    "./vue": "./dist/client/vue/index.js",
    "./angular": {
      "types": "./dist/client/angular/index.d.ts",
      "default": "./dist/client/angular/fesm2022/xp-angular.mjs"
    },
    "./svelte": {
      "types": "./dist/client/svelte/index.d.ts",
      "svelte": "./dist/client/svelte/index.js",
      "default": "./dist/client/svelte/index.js"
    },
    "./solid/v1": {
      "types": "./dist/client/solid/v1.d.ts",
      "browser": "./dist/client/solid/v1.browser.js",
      "default": "./dist/client/solid/v1.server.js"
    },
    "./solid": {
      "types": "./dist/client/solid/v2.d.ts",
      "browser": "./dist/client/solid/v2.browser.js",
      "default": "./dist/client/solid/v2.server.js"
    },
    "./astro": {
      "types": "./dist/client/astro/index.d.mts",
      "default": "./dist/client/astro/index.mjs"
    }
  },
  "scripts": {
    "build": "wireit",
    "build:swc": "swc src -d dist --config-file .swcrc --strip-leading-paths --ignore \"**/__tests__/**,**/client/astro/**,**/client/angular/**,**/client/svelte/**,**/client/solid/**\"",
    "build:tsc": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js",
    "ci": "wireit",
    "circular:check": "wireit",
    "docker:down": "docker compose -f docker-compose.test.yml down",
    "docker:up": "docker compose -f docker-compose.test.yml up -d",
    "format": "wireit",
    "format:check": "wireit",
    "lint": "wireit",
    "lint:unused": "knip",
    "prepare": "husky",
    "test:integration": "wireit",
    "test:unit": "wireit",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.tmp/typecheck.tsbuildinfo",
    "test:package": "wireit",
    "test:generators": "wireit",
    "test:schemas": "wireit",
    "test:transports": "vitest run --config vitest.transport.config.ts",
    "test:hosts": "node scripts/host-package-smoke.mjs",
    "test:journey": "node scripts/test-installed-journey.mjs",
    "test:frontend": "node scripts/test-frontend.mjs",
    "test:frontend:journey": "node scripts/test-frontend-journey.mjs",
    "build:angular": "node scripts/angular/build.mjs",
    "build:svelte": "node tools/svelte/build.mjs",
    "build:solid": "node scripts/build-solid.mjs",
    "build:astro": "node scripts/build-astro.mjs"
  },
  "wireit": {
    "build": {
      "command": "concurrently \"bun build:swc\" \"bun build:tsc\" && bun run build:angular && bun run build:svelte && bun run build:solid && bun run build:astro",
      "files": [
        "src/**/*.{ts,tsx}",
        ".swcrc",
        "tsconfig.json",
        "package.json",
        "scripts/angular/{package.json,bun.lock,tsconfig.json,build.mjs}",
        "src/client/svelte/**/*.svelte",
        "tools/svelte/*.{json,js,mjs,lock}",
        "scripts/build-solid.mjs",
        "scripts/toolchains/solid-config.mjs",
        "scripts/toolchains/solid-v*/{bun.lock,package.json,tsconfig.json,vite.config.mjs}",
        "src/client/astro/**/*",
        "scripts/build-astro.mjs"
      ],
      "output": [
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map",
        "node_modules/.tmp/tsconfig.tsbuildinfo",
        "dist/client/angular/fesm2022/*.mjs",
        "dist/client/svelte/**/*.svelte",
        "dist/client/astro/*.astro",
        "dist/client/astro/*.mjs",
        "dist/client/astro/*.d.mts"
      ],
      "allowUsuallyExcludedPaths": true
    },
    "ci": {
      "dependencies": [
        "build",
        "lint",
        "lint:unused",
        "typecheck",
        "circular:check",
        "format:check",
        "test:unit",
        "test:package",
        "test:generators",
        "test:schemas"
      ]
    },
    "test:unit": {
      "command": "vitest run --config vitest.unit.config.ts",
      "files": [
        "src/**/*.{ts,tsx}",
        "vitest.unit.config.ts",
        "package.json"
      ]
    },
    "test:integration": {
      "command": "vitest run --config vitest.integration.config.ts"
    },
    "circular:check": {
      "command": "dpdm",
      "files": [
        "src/**/*",
        "package.json",
        "tsconfig.json"
      ],
      "output": []
    },
    "format": {
      "command": "oxfmt --write ."
    },
    "format:check": {
      "command": "oxfmt --check ."
    },
    "lint": {
      "command": "oxlint -c oxlint.config.ts . --ignore-pattern \"vitest*.ts\" --deny-warnings",
      "files": [
        "src/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "*.ts",
        "oxlint.config.ts",
        "tsconfig.json"
      ],
      "output": []
    },
    "test:package": {
      "command": "node scripts/package-smoke.mjs",
      "dependencies": [
        "build"
      ]
    },
    "test:generators": {
      "command": "node scripts/setup-generator-smoke.mjs",
      "dependencies": [
        "build"
      ]
    },
    "test:schemas": {
      "command": "node scripts/setup-schema-smoke.mjs"
    }
  },
  "dependencies": {
    "@babel/parser": "^8.1.2",
    "cli-spinners": "^3.4.0",
    "dpdm": "^4.3.0",
    "es-toolkit": "^1.52.0",
    "ink": "^8.0.0",
    "meow": "^14.1.0",
    "pino": "^10.4.0",
    "semver": "7.8.5",
    "string-width": "^9.0.0",
    "type-fest": "^5.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.2",
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/bun": "^1.4.3",
    "@types/express": "^5",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "@types/semver": "7",
    "concurrently": "^10.0.6",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "express": "^5.3.0",
    "graphql": "^16.15.0",
    "graphql-yoga": "^6.1.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "mongodb": "^7.8.0",
    "mssql": "^12.7.14",
    "mysql2": "^3.24.6",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "pg": "^8.23.1",
    "playwright": "1.65.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "sequelize": "^6.37.8",
    "tedious": "^20.3.9",
    "tsc-alias": "^1.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vue": "3.5.46",
    "wireit": "^0.14.13"
  },
  "peerDependencies": {
    "@angular/core": ">=22.3.0 <23",
    "@apollo/server": "^5.5.2",
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "@solidjs/web": ">=2.0.3 <3",
    "astro": ">=7.4.13 <8",
    "express": "^5.3.0",
    "graphql": "^16.15.0",
    "graphql-yoga": "^6.1.0",
    "mongodb": "^7.8.0",
    "mssql": "^12.7.14",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "sequelize": "^6.37.8",
    "solid-js": ">=1.9.20 <1.10 || >=2.0.3 <3",
    "svelte": "^5.59.0",
    "vue": ">=3.5.46 <4"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "mssql": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    },
    "sequelize": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "graphql-yoga": {
      "optional": true
    },
    "@apollo/server": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "@solidjs/web": {
      "optional": true
    },
    "astro": {
      "optional": true
    }
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.4"
}
