{
  "jsc": {
    "baseUrl": ".",
    "parser": {
      "syntax": "typescript",
      "tsx": true,
      "decorators": true,
      "dynamicImport": true
    },
    "target": "esnext",
    "keepClassNames": true,
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "react": {
        "runtime": "automatic"
      }
    },
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "sourceMaps": true,
  "module": {
    "type": "es6",
    "resolveFully": true
  }
}
